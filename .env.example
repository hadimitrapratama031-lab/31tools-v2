# Base URL publik/CDN bucket, TANPA trailing slash. PRODUKSI: pakai Custom Domain
# R2 yang dikonfigurasi di Cloudflare (contoh: https://assets.domainanda.com).
# JANGAN pakai URL S3 API (…r2.cloudflarestorage.com) — itu private. r2.dev hanya
# untuk development (rate-limited). Gambar Marketplace WAJIB lewat URL publik ini.
R2_PUBLIC_URL=https://pub-404c35830dc442a2a7122639fbcd9307.r2.dev
